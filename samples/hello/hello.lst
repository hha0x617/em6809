                      (        hello.asm):00001                 ORG   $E000
     FF00             (        hello.asm):00002         CONBASE EQU   $FF00       ; MC6850 ACIA: status @ +0, data @ +1
     0002             (        hello.asm):00003         TDRE    EQU   $02         ; SR bit1: Transmit Data Register Empty
                      (        hello.asm):00004         
E000 108EFF00         (        hello.asm):00005         START   LDY   #CONBASE
E004 8EE017           (        hello.asm):00006                 LDX   #MSG
E007 E680             (        hello.asm):00007         NEXT    LDB   ,X+         ; 文字取得
E009 270A             (        hello.asm):00008                 BEQ   HALT
E00B A6A4             (        hello.asm):00009         WAIT    LDA   ,Y          ; STATUS = base+0
E00D 8502             (        hello.asm):00010                 BITA  #TDRE
E00F 27FA             (        hello.asm):00011                 BEQ   WAIT
E011 E721             (        hello.asm):00012                 STB   1,Y         ; TX 送信 (base+1)
E013 20F2             (        hello.asm):00013                 BRA   NEXT
                      (        hello.asm):00014         
E015 20FE             (        hello.asm):00015         HALT    BRA   HALT
                      (        hello.asm):00016         
E017 48454C4C4F2C2057 (        hello.asm):00017         MSG     FCC   "HELLO, WORLD"
     4F524C44
E023 0D0A00           (        hello.asm):00018                 FCB   $0D,$0A,0
                      (        hello.asm):00019         
                      (        hello.asm):00020         ; ISR: runs on each timer tick. After 60 ticks, 
                      (        hello.asm):00021         ; No action at this time.
E026 3B               (        hello.asm):00022         IRQ_ENT RTI
                      (        hello.asm):00023         
                      (        hello.asm):00024                 ORG   $FFF4
FFF4 E026             (        hello.asm):00025                 FDB   IRQ_ENT     ; FIRQ vector
                      (        hello.asm):00026                 ORG   $FFF6
FFF6 E026             (        hello.asm):00027                 FDB   IRQ_ENT     ; IRQ vector
                      (        hello.asm):00028                 ORG   $FFFE
FFFE E000             (        hello.asm):00029                 FDB   START
