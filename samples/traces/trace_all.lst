E1C9 17FE4D           00226                 LBSR  PRNT
E1CC 860A             00227                 LDA   #EQU_N|EQU_V ; N=1,V=1 => N^V=0 => BLT not taken
                      00228                 SETCC
E1CE 3402             00001                 PSHS  A
E1D0 3501             00002                 PULS  CC
E1D2 2D08             00229                 BLT   BLT_N
