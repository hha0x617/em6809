E1A5 17FE71           00210                 LBSR  PRNT
E1A8 12               00211         BMI_NEXT NOP
                      00212         
                      00213         ; BGE/BLT uses N^V
E1A9 8E0040           00214                 LDX   #S_BGE
E1AC 17FE6A           00215                 LBSR  PRNT
E1AF 8600             00216                 LDA   #$00        ; N=0,V=0 => N^V=0 => BGE taken
                      00217                 SETCC
E1B1 3402             00001                 PSHS  A
E1B3 3501             00002                 PULS  CC
E1B5 2C08             00218                 BGE   BGE_T
E1B7 8E0007           00219                 LDX   #S_N
E1BA 17FE5C           00220                 LBSR  PRNT
E1BD 2006             00221                 BRA   BGE_NEXT
