E0D7 8E0000           00126         BCC_T   LDX   #S_T
E0DA 17FF3C           00127                 LBSR  PRNT
E0DD 12               00128         BCC_NEXT NOP
E0DE 8E001D           00129                 LDX   #S_BCS
E0E1 17FF35           00130                 LBSR  PRNT
E0E4 8601             00131                 LDA   #EQU_C      ; C=1
                      00132                 SETCC
E0E6 3402             00001                 PSHS  A
E0E8 3501             00002                 PULS  CC
E0EA 2508             00133                 BCS   BCS_T
E0EC 8E0007           00134                 LDX   #S_N
E0EF 17FF27           00135                 LBSR  PRNT
E0F2 2006             00136                 BRA   BCS_NEXT
E0F4 8E0000           00137         BCS_T   LDX   #S_T
E0F7 17FF1F           00138                 LBSR  PRNT
E0FA 12               00139         BCS_NEXT NOP
                      00140         
                      00141         ; BHI ( !(C||Z) ) and BLS (C||Z)
E0FB 8E0022           00142                 LDX   #S_BHI
E0FE 17FF18           00143                 LBSR  PRNT
E101 8600             00144                 LDA   #$00        ; C=0,Z=0 -> taken
                      00145                 SETCC
E103 3402             00001                 PSHS  A
E105 3501             00002                 PULS  CC
E107 2208             00146                 BHI   BHI_T
E109 8E0007           00147                 LDX   #S_N
E10C 17FF0A           00148                 LBSR  PRNT
