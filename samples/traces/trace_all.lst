                      00285         
                      00286         ; --- Page-2 Y/CPY/LDY/STY variants ---
E25B 108E1234         00287                 LDY   #$1234      ; LDY sets N/Z, clears V
E25F 109F20           00288                 STY   <$20        ; STY sets N/Z, clears V (based on Y)
E262 109E20           00289                 LDY   <$20        ; reload
E265 8E4321           00290                 LDX   #$4321
                      00291                 ; CMPY immediate/direct/indexed/extended
E268 108E1111         00292                 LDY   #$1111      ; A(1111)-B(2222): Z=0,N=1,V=0,C=0  (borrow)
E26C 108C2222         00293                 CMPY  #$2222      ; expect NZVC as above
E270 109C20           00294                 CMPY  <$20        ; 1111 - 1234: Z=0,N=1,V=0,C=0
E273 308820           00295                 LEAX  $20,X       ; ensure indexed path exists (8-bit offset indexed)
E276 10AC84           00296                 CMPY  ,X          ; 1111 - 5555: Z=0,N=1,V=0,C=0
E279 109C20           00297                 CMPY  $0020       ; 1111 - 0020: Z=0,N=1,V=0,C=0
                      00298         
                      00299         ; --- Page-2 S-register LDS/STS ---
E27C 10CEAAAA         00300                 LDS   #$AAAA      ; LDS sets N/Z, clears V
E280 10DF30           00301                 STS   <$30        ; STS sets N/Z, clears V (based on S)
E283 10DE30           00302                 LDS   <$30        ; reload
E286 31A830           00303                 LEAY  $0030,Y
E289 10EFA4           00304                 STS   ,Y
E28C 10DF30           00305                 STS   $0030
                      00306         
                      00307         ; --- Page-3 CMPS ---
E28F 10CEBEEF         00308                 LDS   #$BEEF
E293 118CBEEF         00309                 CMPS  #$BEEF      ; equal: Z=1,N=0,V=0,C=1
E297 119C30           00310                 CMPS  <$30        ; compare against previously stored value
E29A 11ACA4           00311                 CMPS  ,Y
E29D 119C30           00312                 CMPS  $0030
                      00313         
E2A0 20FE             00314         DONE    BRA   DONE        ; spin; use --trace --step to inspect
                      00315         
