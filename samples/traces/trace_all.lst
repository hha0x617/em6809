E18B 12               00200         BPL_NEXT NOP
E18C 8E003B           00201                 LDX   #S_BMI
E18F 17FE87           00202                 LBSR  PRNT
E192 8608             00203                 LDA   #EQU_N      ; N=1 -> BMI taken
                      00204                 SETCC
E194 3402             00001                 PSHS  A
E196 3501             00002                 PULS  CC
E198 2B08             00205                 BMI   BMI_T
E19A 8E0007           00206                 LDX   #S_N
E19D 17FE79           00207                 LBSR  PRNT
E1A0 2006             00208                 BRA   BMI_NEXT
