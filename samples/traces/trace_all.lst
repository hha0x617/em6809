E117 12               00152         BHI_NEXT NOP
E118 8E0027           00153                 LDX   #S_BLS
E11B 17FEFB           00154                 LBSR  PRNT
E11E 8601             00155                 LDA   #EQU_C      ; C=1 -> taken
                      00156                 SETCC
E120 3402             00001                 PSHS  A
E122 3501             00002                 PULS  CC
E124 2308             00157                 BLS   BLS_T
E126 8E0007           00158                 LDX   #S_N
E129 17FEED           00159                 LBSR  PRNT
E12C 2006             00160                 BRA   BLS_NEXT
E12E 8E0000           00161         BLS_T   LDX   #S_T
E131 17FEE5           00162                 LBSR  PRNT
E134 12               00163         BLS_NEXT NOP
                      00164         
                      00165         ; BVC/BVS
E135 8E002C           00166                 LDX   #S_BVC
E138 17FEDE           00167                 LBSR  PRNT
E13B 8600             00168                 LDA   #$00        ; V=0 -> BVC taken
                      00169                 SETCC
E13D 3402             00001                 PSHS  A
E13F 3501             00002                 PULS  CC
E141 2808             00170                 BVC   BVC_T
E143 8E0007           00171                 LDX   #S_N
