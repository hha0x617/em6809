                      00001                 ; MC6809 trace ROM to exercise branches and page-2/3 ops
                      00002                 ; Console is optional; use --trace to observe flow.
                      00003                 ; If you pass --console 0xFF00, this program prints branch markers.
                      00004         
                      00005                 ORG   $E000
                      00006         
                      00007         ; CC bits: E(80) F(40) H(20) I(10) N(08) Z(04) V(02) C(01)
     0004             00008         EQU_Z   EQU   $04
     0008             00009         EQU_N   EQU   $08
     0002             00010         EQU_V   EQU   $02
     0001             00011         EQU_C   EQU   $01
                      00012         
                      00013         ; Macro: CC := A via stack
E000                  00014         SETCC   MACRO
                      00015                 PSHS  A
                      00016                 PULS  CC
                      00017                 ENDM
                      00018         
                      00019         ; Console (optional)
     FF00             00020         CONBASE EQU   $FF00
     FF00             00021         CONDATA EQU   CONBASE
     FF01             00022         CONSTAT EQU   CONBASE+1
     0001             00023         TXRDY   EQU   $01         ; status bit0
     00FF             00024         CONON   EQU   $00FF       ; scratch flag in zero page (unused here)
                      00025         
                      00026         ; Simple TX subroutine: waits for TX ready then sends B
E000 3412             00027         TXB     PSHS  A,X
E002 96FF             00028                 LDA   CONON       ; console present?
E004 2711             00029                 BEQ   TXRET       ; skip if not
E006 8E00FF           00030                 LDX   #$00FF      ; timeout to avoid hang
E009 B6FF01           00031         TWAIT   LDA   CONSTAT
E00C 8501             00032                 BITA  #TXRDY
E00E 2604             00033                 BNE   TXGO
E010 301F             00034                 LEAX  -1,X
E012 26F5             00035                 BNE   TWAIT
E014 F7FF00           00036         TXGO    STB   CONDATA
E017 3592             00037         TXRET   PULS  A,X,PC
                      00038         
                      00039         ; Print zero-terminated string at X
E019 3416             00040         PRNT    PSHS  A,B,X
E01B 96FF             00041                 LDA   CONON       ; if no console, skip printing to keep behavior consistent
E01D 2709             00042                 BEQ   PDONE
E01F E680             00043         PLOOP   LDB   ,X+
E021 2705             00044                 BEQ   PDONE
E023 17FFDA           00045                 LBSR  TXB
E026 20F7             00046                 BRA   PLOOP
E028 3596             00047         PDONE   PULS  A,B,X,PC
                      00048         
E02A 10CEE800         00049         START   LDS   #$E800      ; init S
E02E CEE900           00050                 LDU   #$E900      ; init U
E031 8E0100           00051                 LDX   #$0100      ; scratch
E034 108E0200         00052                 LDY   #$0200
                      00053                 ; Probe console presence: if CONSTAT ever shows TXRDY, mark CONON=1
E038 8E0010           00054                 LDX   #$0010
E03B B6FF01           00055         PLOOP2  LDA   CONSTAT
E03E 8501             00056                 BITA  #TXRDY
E040 2706             00057                 BEQ   PSKIP
E042 8601             00058                 LDA   #$01
E044 97FF             00059                 STA   CONON
E046 2004             00060                 BRA   PEND
E048 301F             00061         PSKIP   LEAX  -1,X
E04A 26EF             00062                 BNE   PLOOP2
E04C 12               00063         PEND    NOP
                      00064         
                      00065         ; --- Short branches (Bcc) ---
                      00066         ; BEQ taken: expect Z=1 -> taken
E04D 8E000E           00067                 LDX   #S_BEQ
E050 17FFC6           00068                 LBSR  PRNT
E053 8604             00069                 LDA   #EQU_Z      ; set Z
                      00070                 SETCC              ; CC := Z
E055 3402             00001                 PSHS  A
E057 3501             00002                 PULS  CC
E059 2708             00071                 BEQ   BEQ_T        ; taken
E05B 8E0007           00072                 LDX   #S_N
E05E 17FFB8           00073                 LBSR  PRNT
E061 2006             00074                 BRA   BEQ_NEXT
E063 8E0000           00075         BEQ_T   LDX   #S_T
E066 17FFB0           00076                 LBSR  PRNT
E069 12               00077         BEQ_NEXT NOP
                      00078         ; BEQ not taken: expect Z=0 -> not taken
E06A 8E000E           00079                 LDX   #S_BEQ
E06D 17FFA9           00080                 LBSR  PRNT
E070 8600             00081                 LDA   #$00        ; clear Z
                      00082                 SETCC
E072 3402             00001                 PSHS  A
E074 3501             00002                 PULS  CC
E076 2708             00083                 BEQ   BEQ_N       ; not taken
E078 8E0007           00084                 LDX   #S_N
E07B 17FF9B           00085                 LBSR  PRNT
E07E 2006             00086                 BRA   BEQ_NEND
E080 8E0000           00087         BEQ_N   LDX   #S_T
E083 17FF93           00088                 LBSR  PRNT
E086 12               00089         BEQ_NEND NOP
                      00090         
                      00091         ; BNE tests
                      00092         ; BNE with Z=0 -> taken
E087 8E0013           00093                 LDX   #S_BNE
E08A 17FF8C           00094                 LBSR  PRNT
E08D 8600             00095                 LDA   #$00        ; Z=0
                      00096                 SETCC
E08F 3402             00001                 PSHS  A
E091 3501             00002                 PULS  CC
E093 2608             00097                 BNE   BNE_T
E095 8E0007           00098                 LDX   #S_N
E098 17FF7E           00099                 LBSR  PRNT
E09B 2006             00100                 BRA   BNE_NEXT
E09D 8E0000           00101         BNE_T   LDX   #S_T
E0A0 17FF76           00102                 LBSR  PRNT
E0A3 12               00103         BNE_NEXT NOP
                      00104         ; BNE with Z=1 -> not taken
E0A4 8E0013           00105                 LDX   #S_BNE
E0A7 17FF6F           00106                 LBSR  PRNT
E0AA 8604             00107                 LDA   #EQU_Z
                      00108                 SETCC
E0AC 3402             00001                 PSHS  A
E0AE 3501             00002                 PULS  CC
E0B0 2608             00109                 BNE   BNE_N
E0B2 8E0007           00110                 LDX   #S_N
E0B5 17FF61           00111                 LBSR  PRNT
E0B8 2006             00112                 BRA   BNE_NEND
E0BA 8E0000           00113         BNE_N   LDX   #S_T
E0BD 17FF59           00114                 LBSR  PRNT
E0C0 12               00115         BNE_NEND NOP
                      00116         
                      00117         ; BCC (C=0 -> taken) / BCS (C=1 -> taken)
E0C1 8E0018           00118                 LDX   #S_BCC
E0C4 17FF52           00119                 LBSR  PRNT
E0C7 8600             00120                 LDA   #$00        ; C=0
                      00121                 SETCC
E0C9 3402             00001                 PSHS  A
E0CB 3501             00002                 PULS  CC
E0CD 2408             00122                 BCC   BCC_T
E0CF 8E0007           00123                 LDX   #S_N
E0D2 17FF44           00124                 LBSR  PRNT
