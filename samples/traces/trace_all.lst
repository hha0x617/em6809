                      00188         
                      00189         ; BPL/BMI
E16F 8E0036           00190                 LDX   #S_BPL
E172 17FEA4           00191                 LBSR  PRNT
E175 8600             00192                 LDA   #$00        ; N=0 -> BPL taken
                      00193                 SETCC
E177 3402             00001                 PSHS  A
E179 3501             00002                 PULS  CC
E17B 2A08             00194                 BPL   BPL_T
E17D 8E0007           00195                 LDX   #S_N
E180 17FE96           00196                 LBSR  PRNT
E183 2006             00197                 BRA   BPL_NEXT
