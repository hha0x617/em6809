                      (    trace_all.asm):00001                 ; MC6809 trace ROM to exercise branches and page-2/3 ops
                      (    trace_all.asm):00002                 ; Console is optional; use --trace to observe flow.
                      (    trace_all.asm):00003                 ; If you pass --console 0xFF00, this program prints branch markers.
                      (    trace_all.asm):00004         
                      (    trace_all.asm):00005                 ORG   $E000
                      (    trace_all.asm):00006         
                      (    trace_all.asm):00007         ; CC bits: E(80) F(40) H(20) I(10) N(08) Z(04) V(02) C(01)
     0050             (    trace_all.asm):00008         EQU_DI  EQU   $50         ; disable FIRQ($40) and IRQ($10) masks
     0004             (    trace_all.asm):00009         EQU_Z   EQU   $04
     0008             (    trace_all.asm):00010         EQU_N   EQU   $08
     0002             (    trace_all.asm):00011         EQU_V   EQU   $02
     0001             (    trace_all.asm):00012         EQU_C   EQU   $01
                      (    trace_all.asm):00013         
                      (    trace_all.asm):00014         ; Macro: CC := A via stack
E000                  (    trace_all.asm):00015         SETCC   MACRO
                      (    trace_all.asm):00016                 PSHS  A
                      (    trace_all.asm):00017                 PULS  CC
                      (    trace_all.asm):00018                 ENDM
                      (    trace_all.asm):00019         
                      (    trace_all.asm):00020         ; Console (optional)
     FF00             (    trace_all.asm):00021         CONBASE EQU   $FF00
     FF00             (    trace_all.asm):00022         CONDATA EQU   CONBASE
     FF01             (    trace_all.asm):00023         CONSTAT EQU   CONBASE+1
     0001             (    trace_all.asm):00024         TXRDY   EQU   $01         ; status bit0
     00FF             (    trace_all.asm):00025         CONON   EQU   $00FF       ; scratch flag in zero page (unused here)
                      (    trace_all.asm):00026         
                      (    trace_all.asm):00027         ; Simple TX subroutine: waits for TX ready then sends B
E000 3412             (    trace_all.asm):00028         TXB     PSHS  A,X
E002 96FF             (    trace_all.asm):00029                 LDA   CONON       ; console present?
E004 2711             (    trace_all.asm):00030                 BEQ   TXRET       ; skip if not
E006 8E00FF           (    trace_all.asm):00031                 LDX   #$00FF      ; timeout to avoid hang
E009 B6FF01           (    trace_all.asm):00032         TWAIT   LDA   CONSTAT
E00C 8501             (    trace_all.asm):00033                 BITA  #TXRDY
E00E 2604             (    trace_all.asm):00034                 BNE   TXGO
E010 301F             (    trace_all.asm):00035                 LEAX  -1,X
E012 26F5             (    trace_all.asm):00036                 BNE   TWAIT
E014 F7FF00           (    trace_all.asm):00037         TXGO    STB   CONDATA
E017 3592             (    trace_all.asm):00038         TXRET   PULS  A,X,PC
                      (    trace_all.asm):00039         
                      (    trace_all.asm):00040         ; Print zero-terminated string at X
