                      (/mmu_map_demo.asm):00001         ; MMU map/protection demonstration for em6809
                      (/mmu_map_demo.asm):00002         ; - Splits the logical page $0C differently between system/user maps
                      (/mmu_map_demo.asm):00003         ; - Shows write-protect fault reporting on the vectors page
                      (/mmu_map_demo.asm):00004         ;
                      (/mmu_map_demo.asm):00005         ; Assemble (requires lwasm):
                      (/mmu_map_demo.asm):00006         ;   lwasm -9 --format=srec -o samples/mmu/mmu_map_demo.s19 samples/mmu/mmu_map_demo.asm
                      (/mmu_map_demo.asm):00007         ; Run:
                      (/mmu_map_demo.asm):00008         ;   cargo run -- samples/mmu/mmu_map_demo.s19 \
                      (/mmu_map_demo.asm):00009         ;     --mmu --console 0xFF00 --console-echo --mmu-log-maps --run
                      (/mmu_map_demo.asm):00010         
     FF00             (/mmu_map_demo.asm):00011         CONBASE     EQU   $FF00
     FF00             (/mmu_map_demo.asm):00012         CONDATA     EQU   CONBASE
     FF01             (/mmu_map_demo.asm):00013         CONSTAT     EQU   CONBASE+1
     0001             (/mmu_map_demo.asm):00014         TXRDY       EQU   $01
                      (/mmu_map_demo.asm):00015         
     FFA0             (/mmu_map_demo.asm):00016         MMU_BASE    EQU   $FFA0
     FFA0             (/mmu_map_demo.asm):00017         MMU_MAP     EQU   MMU_BASE          ; +page (0..0F) -> frame#
     FFB0             (/mmu_map_demo.asm):00018         MMU_TASK    EQU   MMU_BASE+$10
     FFB1             (/mmu_map_demo.asm):00019         MMU_MODE    EQU   MMU_BASE+$11      ; 0=user, 1=system
     FFB2             (/mmu_map_demo.asm):00020         MMU_PROT    EQU   MMU_BASE+$12      ; bit0=WPROT_EN, bit3=NX_EN, bit1=IRQ on fault
     FFB3             (/mmu_map_demo.asm):00021         MMU_FAULT   EQU   MMU_BASE+$13      ; latched fault bits, clears on read
     FFB8             (/mmu_map_demo.asm):00022         MMU_ATTR    EQU   MMU_BASE+$18      ; +page -> attr (bit0=WPROT, bit2=NX)
                      (/mmu_map_demo.asm):00023         
     000C             (/mmu_map_demo.asm):00024         PAGE_BANK   EQU   $0C               ; logical page to flip
     000C             (/mmu_map_demo.asm):00025         FRAME_SYS   EQU   $0C               ; system map frame for $0C
     000D             (/mmu_map_demo.asm):00026         FRAME_USER  EQU   $0D               ; user map frame for $0C
     C100             (/mmu_map_demo.asm):00027         LOG_BANK    EQU   $C100             ; logical address used to read banked text
     000F             (/mmu_map_demo.asm):00028         PAGE_VECT   EQU   $0F
     000B             (/mmu_map_demo.asm):00029         PROT_FLAGS  EQU   $0B               ; WPROT_EN + IRQ on fault + NX_EN
                      (/mmu_map_demo.asm):00030         
                      (/mmu_map_demo.asm):00031                 ORG   $E000
                      (/mmu_map_demo.asm):00032         
E000 10CEE1FF         (/mmu_map_demo.asm):00033         START   LDS   #$E1FF
E004 BDE023           (/mmu_map_demo.asm):00034                 JSR   INIT_MMU
E007 8EE200           (/mmu_map_demo.asm):00035                 LDX   #MSG_HELLO
E00A BDE09D           (/mmu_map_demo.asm):00036                 JSR   PRINT_STR
                      (/mmu_map_demo.asm):00037         
                      (/mmu_map_demo.asm):00038                 ; User map view (page $0C -> frame $0D)
E00D 7FFFB1           (/mmu_map_demo.asm):00039                 CLR   MMU_MODE
E010 BDE048           (/mmu_map_demo.asm):00040                 JSR   SHOW_VIEW
                      (/mmu_map_demo.asm):00041         
                      (/mmu_map_demo.asm):00042                 ; System map view (page $0C -> frame $0C)
E013 8601             (/mmu_map_demo.asm):00043                 LDA   #$01
E015 B7FFB1           (/mmu_map_demo.asm):00044                 STA   MMU_MODE
E018 BDE048           (/mmu_map_demo.asm):00045                 JSR   SHOW_VIEW
                      (/mmu_map_demo.asm):00046         
                      (/mmu_map_demo.asm):00047                 ; Write-protect demo on vectors page
E01B 7FFFB1           (/mmu_map_demo.asm):00048                 CLR   MMU_MODE
E01E BDE07A           (/mmu_map_demo.asm):00049                 JSR   TEST_WPROT
                      (/mmu_map_demo.asm):00050         
E021 20FE             (/mmu_map_demo.asm):00051         HALT    BRA   HALT
                      (/mmu_map_demo.asm):00052         
                      (/mmu_map_demo.asm):00053         ; Configure MMU maps and protection.
E023                  (/mmu_map_demo.asm):00054         INIT_MMU
E023 3402             (/mmu_map_demo.asm):00055                 PSHS  A
                      (/mmu_map_demo.asm):00056                 ; Program system map entry for page $0C -> frame $0C
E025 8601             (/mmu_map_demo.asm):00057                 LDA   #$01
E027 B7FFB1           (/mmu_map_demo.asm):00058                 STA   MMU_MODE
E02A 860C             (/mmu_map_demo.asm):00059                 LDA   #FRAME_SYS
E02C B7FFAC           (/mmu_map_demo.asm):00060                 STA   MMU_MAP+PAGE_BANK
                      (/mmu_map_demo.asm):00061                 ; Program user map entry for page $0C -> frame $0D
E02F 7FFFB1           (/mmu_map_demo.asm):00062                 CLR   MMU_MODE
E032 860D             (/mmu_map_demo.asm):00063                 LDA   #FRAME_USER
E034 B7FFAC           (/mmu_map_demo.asm):00064                 STA   MMU_MAP+PAGE_BANK
                      (/mmu_map_demo.asm):00065                 ; Enable NX/WPROT controls and mark pages
E037 860B             (/mmu_map_demo.asm):00066                 LDA   #PROT_FLAGS
E039 B7FFB2           (/mmu_map_demo.asm):00067                 STA   MMU_PROT
E03C 8604             (/mmu_map_demo.asm):00068                 LDA   #$04                 ; NX on page 0 to catch null jumps
E03E B7FFB8           (/mmu_map_demo.asm):00069                 STA   MMU_ATTR+0
E041 8601             (/mmu_map_demo.asm):00070                 LDA   #$01                 ; WPROT vectors page
E043 B7FFC7           (/mmu_map_demo.asm):00071                 STA   MMU_ATTR+PAGE_VECT
E046 3582             (/mmu_map_demo.asm):00072                 PULS  A,PC
                      (/mmu_map_demo.asm):00073         
                      (/mmu_map_demo.asm):00074         ; Print current map entry and banked text.
E048                  (/mmu_map_demo.asm):00075         SHOW_VIEW
E048 3416             (/mmu_map_demo.asm):00076                 PSHS  A,B,X
E04A B6FFB1           (/mmu_map_demo.asm):00077                 LDA   MMU_MODE
E04D 2705             (/mmu_map_demo.asm):00078                 BEQ   SV_USER
E04F 8EE23B           (/mmu_map_demo.asm):00079                 LDX   #MSG_SYS
E052 2003             (/mmu_map_demo.asm):00080                 BRA   SV_LABEL
E054 8EE217           (/mmu_map_demo.asm):00081         SV_USER LDX   #MSG_USER
E057 BDE09D           (/mmu_map_demo.asm):00082         SV_LABEL JSR  PRINT_STR
E05A 8EE261           (/mmu_map_demo.asm):00083                 LDX   #MSG_MAP
E05D BDE09D           (/mmu_map_demo.asm):00084                 JSR   PRINT_STR
E060 B6FFAC           (/mmu_map_demo.asm):00085                 LDA   MMU_MAP+PAGE_BANK
E063 BDE0B7           (/mmu_map_demo.asm):00086                 JSR   PRINT_HEX
E066 BDE0D9           (/mmu_map_demo.asm):00087                 JSR   PRINT_NL
E069 8EE273           (/mmu_map_demo.asm):00088                 LDX   #MSG_TEXT
E06C BDE09D           (/mmu_map_demo.asm):00089                 JSR   PRINT_STR
E06F 8EC100           (/mmu_map_demo.asm):00090                 LDX   #LOG_BANK
E072 BDE09D           (/mmu_map_demo.asm):00091                 JSR   PRINT_STR
E075 BDE0D9           (/mmu_map_demo.asm):00092                 JSR   PRINT_NL
E078 3596             (/mmu_map_demo.asm):00093                 PULS  A,B,X,PC
                      (/mmu_map_demo.asm):00094         
                      (/mmu_map_demo.asm):00095         ; Attempt a write to the protected vectors page and show fault_status.
E07A                  (/mmu_map_demo.asm):00096         TEST_WPROT
E07A 3416             (/mmu_map_demo.asm):00097                 PSHS  A,B,X
E07C 8EE282           (/mmu_map_demo.asm):00098                 LDX   #MSG_WPROT
E07F BDE09D           (/mmu_map_demo.asm):00099                 JSR   PRINT_STR
E082 8601             (/mmu_map_demo.asm):00100                 LDA   #$01
E084 B7FFC7           (/mmu_map_demo.asm):00101                 STA   MMU_ATTR+PAGE_VECT
E087 8655             (/mmu_map_demo.asm):00102                 LDA   #$55
E089 B7FFF0           (/mmu_map_demo.asm):00103                 STA   $FFF0               ; falls in vectors page ($0F), WPROT triggers
E08C B6FFB3           (/mmu_map_demo.asm):00104                 LDA   MMU_FAULT           ; read & clear fault bits
E08F 8EE2A6           (/mmu_map_demo.asm):00105                 LDX   #MSG_FAULT
E092 BDE09D           (/mmu_map_demo.asm):00106                 JSR   PRINT_STR
E095 BDE0B7           (/mmu_map_demo.asm):00107                 JSR   PRINT_HEX
E098 BDE0D9           (/mmu_map_demo.asm):00108                 JSR   PRINT_NL
E09B 3596             (/mmu_map_demo.asm):00109                 PULS  A,B,X,PC
                      (/mmu_map_demo.asm):00110         
                      (/mmu_map_demo.asm):00111         ; Print null-terminated string pointed by X.
E09D                  (/mmu_map_demo.asm):00112         PRINT_STR
E09D 3416             (/mmu_map_demo.asm):00113                 PSHS  A,B,X
E09F A680             (/mmu_map_demo.asm):00114         PS_LOOP LDA   ,X+
E0A1 2704             (/mmu_map_demo.asm):00115                 BEQ   PS_DONE
E0A3 8D04             (/mmu_map_demo.asm):00116                 BSR   TXA
E0A5 20F8             (/mmu_map_demo.asm):00117                 BRA   PS_LOOP
E0A7 3596             (/mmu_map_demo.asm):00118         PS_DONE PULS  A,B,X,PC
                      (/mmu_map_demo.asm):00119         
                      (/mmu_map_demo.asm):00120         ; Transmit A via console (polling TXRDY).
E0A9 3404             (/mmu_map_demo.asm):00121         TXA     PSHS  B
E0AB F6FF01           (/mmu_map_demo.asm):00122         TX_WAIT LDB   CONSTAT
E0AE C501             (/mmu_map_demo.asm):00123                 BITB  #TXRDY
E0B0 27F9             (/mmu_map_demo.asm):00124                 BEQ   TX_WAIT
E0B2 B7FF00           (/mmu_map_demo.asm):00125                 STA   CONDATA
E0B5 3584             (/mmu_map_demo.asm):00126                 PULS  B,PC
                      (/mmu_map_demo.asm):00127         
                      (/mmu_map_demo.asm):00128         ; Print "$xx" from A.
E0B7                  (/mmu_map_demo.asm):00129         PRINT_HEX
E0B7 3406             (/mmu_map_demo.asm):00130                 PSHS  A,B
E0B9 1F89             (/mmu_map_demo.asm):00131                 TFR   A,B
E0BB 8624             (/mmu_map_demo.asm):00132                 LDA   #'$'
E0BD 8DEA             (/mmu_map_demo.asm):00133                 BSR   TXA
E0BF 1F98             (/mmu_map_demo.asm):00134                 TFR   B,A
