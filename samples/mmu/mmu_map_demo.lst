E0D9 3402             (/mmu_map_demo.asm):00153                 PSHS  A
E0DB 860D             (/mmu_map_demo.asm):00154                 LDA   #$0D
E0DD 8DCA             (/mmu_map_demo.asm):00155                 BSR   TXA
E0DF 860A             (/mmu_map_demo.asm):00156                 LDA   #$0A
E0E1 8DC6             (/mmu_map_demo.asm):00157                 BSR   TXA
E0E3 3582             (/mmu_map_demo.asm):00158                 PULS  A,PC
                      (/mmu_map_demo.asm):00159         
